<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.docuai</groupId>
        <artifactId>docuai-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>docuai-ai-orchestration</artifactId>
    <name>docuai-ai-orchestration</name>
    <description>
        Infrastructure IA : Pattern Stratégie multi-fournisseurs (AiProviderPort),
        Prompt Builder, pipeline RAG (embeddings + recherche pgvector),
        Structural Validator, Content Assembler.

        Choix documenté (section 3 du prompt maître, alternative prévue si
        Spring AI ne convient pas) : abstraction MANUELLE plutôt que Spring AI.
        Spring AI (1.0.0-M3 au moment de l'écriture) est encore en milestone,
        avec une surface d'API qui bouge entre versions ; dans un environnement
        où aucune compilation locale n'est possible pour valider les
        changements (cf. rapport de livraison), s'appuyer sur des clients HTTP
        explicites (WebClient) par fournisseur, aux contrats stables et
        documentés publiquement (OpenAI, Anthropic, Ollama), réduit le risque
        de rupture silencieuse. Cette couche reste isolée derrière
        AiProviderPort : migrer vers Spring AI plus tard ne toucherait que ce
        module.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.docuai</groupId>
            <artifactId>docuai-core</artifactId>
        </dependency>
        <!--
            spring-boot-starter-webflux fournit WebClient (client HTTP réactif
            utilisé pour appeler les fournisseurs IA, y compris en streaming
            SSE/NDJSON) et Flux (contrat AiProviderPort.streamGenerate).
            Il n'entraîne PAS de bascule de docuai-api vers un serveur
            réactif : Spring Boot ne choisit WebApplicationType.REACTIVE que
            si aucun DispatcherServlet n'est présent sur le classpath, or
            docuai-api dépend de spring-boot-starter-web (servlet) — donc le
            type d'application effectif reste SERVLET (voir
            WebApplicationType.deduceFromClasspath). WebClient est simplement
            utilisé de façon imperative-friendly (bloquant côté appelant si
            besoin) ou réellement en streaming pour la génération.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
