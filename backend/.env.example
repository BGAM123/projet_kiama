# =============================================================================
# DocuAI — variables d'environnement (copier en .env avant `docker compose up`)
# =============================================================================

# --- Base de données Postgres (avec extension pgvector) -----------------------
POSTGRES_DB=docuai
POSTGRES_USER=docuai
POSTGRES_PASSWORD=docuai
POSTGRES_PORT=5432

# --- Redis (cache, blacklist JWT, verrous asynchrones) -----------------------
REDIS_PORT=6379

# --- MinIO (stockage objets S3-compatible) -----------------------------------
MINIO_ROOT_USER=docuai
MINIO_ROOT_PASSWORD=docuai-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_SOURCES=docuai-sources
MINIO_BUCKET_REFERENCES=docuai-references
MINIO_BUCKET_EXPORTS=docuai-exports

# --- Backend Spring Boot -----------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Sécurité JWT (RS256) ----------------------------------------------------
# Générer une paire clé RSA (2048) :
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Coller ici les clés en PEM sur une seule ligne (\\n au lieu de sauts de ligne),
# ou laisser vide en dev — une paire éphémère sera générée au démarrage.
DOCUAI_JWT_ISSUER=docuai
DOCUAI_JWT_PRIVATE_KEY=
DOCUAI_JWT_PUBLIC_KEY=

# Mot de passe du compte admin bootstrappé par la migration V2 (obligatoire à
# changer en prod). Utilisé une seule fois au démarrage initial.
DOCUAI_ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!2026

# --- Fournisseurs IA (clés API) ---------------------------------------------
# Laisser vide un fournisseur non utilisé — l'adaptateur restera inactif
# et sera signalé indisponible via GET /api/v1/ai-configs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
