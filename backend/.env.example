# =============================================================================
# DocuAI — variables d'environnement (copier en .env avant `docker compose up`)
# =============================================================================

# --- Base de données Postgres (avec extension pgvector) -----------------------
POSTGRES_DB=docuai
POSTGRES_USER=docuai
POSTGRES_PASSWORD=docuai
POSTGRES_PORT=5432

# --- Redis (cache, liste noire JWT, état des tâches d'extraction async) ------
REDIS_PORT=6379

# --- MinIO (stockage objet S3-compatible) -------------------------------------
MINIO_ROOT_USER=docuai
MINIO_ROOT_PASSWORD=docuai-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_SOURCES=docuai-sources
MINIO_BUCKET_REFERENCES=docuai-references
MINIO_BUCKET_EXPORTS=docuai-exports

# --- Backend Spring Boot ------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Sécurité JWT (RS256) ------------------------------------------------------
# Paire de clés RSA obligatoire (RS256, pas de secret partagé HS256 en V1).
# Génération locale :
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Coller le contenu PEM ici sur une seule ligne, avec des \n littéraux à la
# place des retours à la ligne (JwtKeyProperties les reconvertit au chargement).
# Un jeu de clés de développement DOIT être généré avant le premier démarrage
# (aucune valeur par défaut fournie ici volontairement, pour ne pas laisser
# tourner un environnement — même local — sans clé propre).
DOCUAI_JWT_ISSUER=docuai
DOCUAI_JWT_PRIVATE_KEY=
DOCUAI_JWT_PUBLIC_KEY=
DOCUAI_JWT_ACCESS_TTL_SECONDS=900
DOCUAI_JWT_REFRESH_TTL_SECONDS=604800

# Mot de passe initial du compte admin bootstrappé par la migration V2.
DOCUAI_ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!2026

# --- E-mails transactionnels (Mailhog en dev, cf. service mailhog ci-dessous) --
# Adresse d'expéditeur de l'e-mail de bienvenue envoyé à la création d'un
# utilisateur (identifiants initiaux). Consulter les e-mails envoyés en dev :
# http://localhost:8025.
DOCUAI_MAIL_FROM=no-reply@docuai.local
# Base de l'URL du frontend, utilisée pour le lien de connexion dans l'e-mail.
DOCUAI_FRONTEND_URL=http://localhost:3000

# --- Fournisseurs IA (clés API) -----------------------------------------------
# Laisser vide un fournisseur non utilisé — l'adaptateur restera inactif et
# sera signalé indisponible via GET /api/v1/ai-configs. Tous les fournisseurs
# ci-dessous sont réellement implémentés (appels HTTP réels, @Component actif) —
# voir docuai-ai-orchestration/README.md pour le détail par fournisseur.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=
# DashScope (Alibaba Cloud), mode compatible OpenAI — https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=

# --- Antivirus (optionnel) -----------------------------------------------------
# Désactivé par défaut. Pour l'activer : `docker compose --profile av up` et
# DOCUAI_CLAMAV_ENABLED=true.
DOCUAI_CLAMAV_ENABLED=false
CLAMAV_PORT=3310
