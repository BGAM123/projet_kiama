<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.docuai</groupId>
        <artifactId>docuai-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>docuai-security</artifactId>
    <name>docuai-security</name>
    <description>
        Infrastructure de sécurité : JWT RS256 (émission/validation), filtres
        Spring Security, RBAC, liste noire Redis des refresh tokens révoqués.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.docuai</groupId>
            <artifactId>docuai-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            Nécessaires car spring-security-web (amené par
            spring-boot-starter-security) déclare jakarta.servlet-api en scope
            "provided" — un scope non transitif en Maven. docuai-security
            référence directement HttpServletRequest/Filter/... (dans
            JwtAuthenticationFilter, JwtAuthenticationEntryPoint) et doit donc
            le redéclarer explicitement pour compiler seul, indépendamment du
            fait que docuai-api (spring-boot-starter-web) l'apporte à
            l'exécution. Version gérée par le BOM spring-boot-starter-parent,
            pas besoin de la préciser.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            JwtAuthenticationEntryPoint sérialise directement le corps d'erreur
            JSON avec un ObjectMapper Jackson (nécessaire car ce point d'entrée
            s'exécute avant tout @ControllerAdvice, cf. sa Javadoc) — Jackson
            n'est pas amené transitivement par spring-boot-starter-security.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
